{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wyy",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wyy-comments",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ]
}
